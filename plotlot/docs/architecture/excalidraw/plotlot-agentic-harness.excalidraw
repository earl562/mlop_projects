      "versionNonce": 2735,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PITFALL CONTROLS\n\n- No giant super-agent\n- Scoped skill lanes + toolsets\n- Official local evidence controls zoning facts\n- Rehab Valuator supplies workflow concepts only\n- Every formula stores inputs, source IDs, and assumptions\n- Browser comping is adapter, not truth\n- Entitlement/upzoning upside is never guaranteed\n- Reports separate verified facts, calculations, assumptions, warnings\n- Repair steps when evidence is missing or contradictory\n- Golden evals fail unsupported deal or lender claims",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PITFALL CONTROLS\n\n- No giant super-agent\n- Scoped skill lanes + toolsets\n- Official local evidence controls zoning facts\n- Rehab Valuator supplies workflow concepts only\n- Every formula stores inputs, source IDs, and assumptions\n- Browser comping is adapter, not truth\n- Entitlement/upzoning upside is never guaranteed\n- Reports separate verified facts, calculations, assumptions, warnings\n- Repair steps when evidence is missing or contradictory\n- Golden evals fail unsupported deal or lender claims",
      "lineHeight": 1.25,
      "baseline": 20
    },
