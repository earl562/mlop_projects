mlruns/

# Generated/private SQLite state is never source
**/*.db
**/*.sqlite
**/*.sqlite3

# Generated package-manager and Firebase CLI debug logs
**/firebase-debug.log
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log

# Frontend
**/node_modules/
.vercel
/.omx/

# Non-canonical frontend roots (only plotlot/frontend/ is canonical)
apps/plotlot/frontend/package-lock.json

# Playwright and local capture artifacts
.playwright-mcp/
apps/plotlot/frontend/playwright-report/
apps/plotlot/frontend/test-results/
apps/plotlot/frontend/tests/screenshots/
apps/plotlot/tests/screenshots/
apps/plotlot/frontend/playwright-chat-before.png
apps/plotlot/frontend/playwright-chat-after.png
apps/plotlot/frontend/IMAGE_TO_CODE_WORKFLOW.md

# Agent/browser evidence and generated design renders
.omo/evidence/
plotlot/artifacts/design/**/reference-*.png

# Frontend design/reference assets (not required to run PlotLot)
apps/plotlot/frontend/public/plotlot-assets/
apps/plotlot/frontend/public/plotlot-comps/
apps/plotlot/frontend/public/plotlot-ref/
!apps/plotlot/frontend/public/plotlot-assets/
!apps/plotlot/frontend/public/plotlot-assets/**
!apps/plotlot/frontend/public/plotlot-ref/
!apps/plotlot/frontend/public/plotlot-ref/**

# Local PlotLot scratch outputs
/plotlot-*.png
/plotlot-*.md
/plotlot-*.log
/plotlot-*.json
/plotlot-*-network.json
/plotlot-*-analysis-*.json
/plotlot-*-home-*.json

# Root-level media dumps should never be tracked
/*.png
/*.jpg
/*.jpeg
/*.webm
/*.zip

# Research caches (downloaded PDFs, extracted text)
docs/research/_cache/
docs/research/_tmp-*

# Python typing cache
.mypy_cache/

#Handoff
HANDOFF.md
OUTREACH.md
outreach-agent

# Claude Code local settings (contains personal permissions/hooks)
.claude/settings.json
