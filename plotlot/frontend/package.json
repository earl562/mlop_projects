{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:turbo": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:matrix": "mkdir -p .quality-matrix && vitest run --config vitest.config.ts --reporter=json --outputFile=.quality-matrix/vitest.json",
    "test:e2e": "npm run test:e2e:no-db",
    "test:e2e:lookup-uat": "rm -f .quality-matrix/playwright-lookup-uat.json && PLOTLOT_MATRIX_LANE=lookup-uat npx playwright test tests/lookup-uat.spec.ts --project=chromium",
    "test:e2e:no-db": "rm -f .quality-matrix/playwright-no-db.json && PLOTLOT_MATRIX_LANE=no-db NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000} npx playwright test --project=no-db",
    "test:e2e:vc": "rm -f .quality-matrix/playwright-vc.json && PLOTLOT_MATRIX_LANE=vc NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000} npx playwright test tests/vc-readiness.no-db.spec.ts --project=no-db",
    "test:e2e:db": "rm -f .quality-matrix/playwright-db-backed.json && PLOTLOT_RELEASE_GATE=1 PLOTLOT_MATRIX_LANE=db-backed NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000} npx playwright test --project=db-backed",
    "test:e2e:recorded-real": "rm -f .quality-matrix/playwright-recorded-real.json && PLOTLOT_MATRIX_LANE=recorded-real npx playwright test --project=recorded-real",
    "test:e2e:visual": "rm -f .quality-matrix/playwright-visual.json && PLOTLOT_MATRIX_LANE=visual npx playwright test --project=visual",
    "test:e2e:accessibility": "rm -f .quality-matrix/playwright-accessibility.json && PLOTLOT_MATRIX_LANE=accessibility npx playwright test --project=accessibility",
    "test:e2e:performance": "rm -f .quality-matrix/playwright-performance.json && PLOTLOT_MATRIX_LANE=performance npx playwright test --project=performance",
    "test:e2e:live-agent": "rm -f .quality-matrix/playwright-live.json && PLOTLOT_RELEASE_GATE=1 PLOTLOT_LIVE_AGENT_E2E=1 PLOTLOT_MATRIX_LANE=live NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://127.0.0.1:8000} npx playwright test --project=live",
    "test:quality-mutations": "node scripts/run-quality-mutations.mjs",
    "test:quality-matrix": "node scripts/build-quality-matrix.mjs",
    "verify:local": "npm run lint && npx tsc --noEmit && npm run test:ui && npx playwright test tests/design-system.spec.ts --project=chromium && npm run build",
    "verify:tdd": "npm run lint && npx tsc --noEmit && npm run test:ui"
  },
  "dependencies": {
    "@clerk/nextjs": "7.2.4",
    "@fal-ai/client": "^1.9.4",
    "@fal-ai/server-proxy": "^1.2.1",
    "@vis.gl/react-google-maps": "^1.7.1",
    "esri-leaflet": "^3.0.19",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "15.5.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}
