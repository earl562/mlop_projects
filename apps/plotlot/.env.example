# PlotLot v2 — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# PostgreSQL + pgvector (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://plotlot:plotlot@localhost:5433/plotlot

# HuggingFace Inference API (for embeddings)
HF_TOKEN=hf_your_token_here

# Geocodio (for address → coordinates)
GEOCODIO_API_KEY=

# LLM providers for agent chat.
# Runtime preference: GROQ_API_KEY → NVIDIA_API_KEY → OpenAI/Codex OAuth → OpenRouter fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_FALLBACK_MODEL=minimaxai/minimax-m2.5

# OpenAI/Codex OAuth LLM provider
# Use OPENAI_ACCESS_TOKEN when your org supplies OAuth bearer tokens.
# Use OPENAI_API_KEY for direct OpenAI API-key auth.
# Or use local Codex OAuth tokens with PLOTLOT_USE_CODEX_OAUTH=1.
OPENAI_API_KEY=
OPENAI_ACCESS_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_REASONING_EFFORT=medium
PLOTLOT_USE_CODEX_OAUTH=0
PLOTLOT_CODEX_AUTH_FILE=~/.codex/auth.json
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
OPENAI_OAUTH_REDIRECT_URI=http://127.0.0.1:1455/auth/callback
OPENAI_OAUTH_SCOPE="openid offline_access"

# OpenRouter (OpenAI-compatible) — fallback provider when OpenAI fails (quota, 429, etc.)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Example: openai/gpt-4.1, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, etc.
# If unset, PlotLot derives a default from OPENAI_MODEL.
OPENROUTER_MODEL=
# Optional attribution headers recommended by OpenRouter
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=PlotLot Local Dev

# Sentry (error tracking)
SENTRY_DSN=

# Jina.ai (web search for chat agent)
JINA_API_KEY=

# Local generated artifact storage and ArcGIS discovery cache
ARTIFACT_STORAGE_DIR=data/artifacts
PROPERTY_CACHE_PATH=data/cache/property_cache.json

# MLflow experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=plotlot-rag
